From 4226f94ff94365a3705c5fa2b293c4fb8120a325 Mon Sep 17 00:00:00 2001
From: Bruno Martins <bgcngm@gmail.com>
Date: Sun, 11 Oct 2026 23:15:57 +0100
Subject: [PATCH] sepolicy: qti: Also support Dolby Vision HIDL service

Change-Id: I0e5317a310d32666be539560516e518911be11b6
---

diff --git a/sepolicy/qti/vendor/file_contexts b/sepolicy/qti/vendor/file_contexts
index f0a98ac..0536272 100644
--- a/sepolicy/qti/vendor/file_contexts
+++ b/sepolicy/qti/vendor/file_contexts
@@ -39,6 +39,7 @@
 /(odm|vendor/odm)/bin/hw/vendor\.pixelworks\.hardware\.feature-service                 u:object_r:hal_feature_irisfeature_default_exec:s0
 
 # Dolby Vision
+/(odm|vendor/odm)/bin/hw/dvs-hal-service     u:object_r:hal_dvs_default_exec:s0
 /(odm|vendor/odm)/bin/hw/dvs-aidl-service    u:object_r:hal_dolby_dvs_aidl_exec:s0
 
 # Engineering
diff --git a/sepolicy/qti/vendor/hal_dolby_dvs.te b/sepolicy/qti/vendor/hal_dolby_dvs.te
new file mode 100644
index 0000000..6e56196
--- /dev/null
+++ b/sepolicy/qti/vendor/hal_dolby_dvs.te
@@ -0,0 +1,2 @@
+binder_call(vendor_hal_dolby_dvs_client, vendor_hal_dolby_dvs_server)
+binder_call(vendor_hal_dolby_dvs_server, vendor_hal_dolby_dvs_client)
diff --git a/sepolicy/qti/vendor/hal_dolby_dvs_aidl.te b/sepolicy/qti/vendor/hal_dolby_dvs_aidl.te
index f2e3fcb..2e61aa9 100644
--- a/sepolicy/qti/vendor/hal_dolby_dvs_aidl.te
+++ b/sepolicy/qti/vendor/hal_dolby_dvs_aidl.te
@@ -5,8 +5,6 @@
 init_daemon_domain(hal_dolby_dvs_aidl)
 
 binder_call(hal_dolby_dvs_aidl, system_server)
-binder_call(vendor_hal_dolby_dvs_client, vendor_hal_dolby_dvs_server)
-binder_call(vendor_hal_dolby_dvs_server, vendor_hal_dolby_dvs_client)
 
 hal_server_domain(hal_dolby_dvs_aidl, vendor_hal_dolby_dvs)
 
diff --git a/sepolicy/qti/vendor/hal_dvs_default.te b/sepolicy/qti/vendor/hal_dvs_default.te
new file mode 100644
index 0000000..c00237b
--- /dev/null
+++ b/sepolicy/qti/vendor/hal_dvs_default.te
@@ -0,0 +1,21 @@
+type hal_dvs_default, domain;
+binder_use(hal_dvs_default)
+hwbinder_use(hal_dvs_default)
+
+hal_server_domain(hal_dvs_default, vendor_hal_dolby_dvs)
+
+type hal_dvs_default_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(hal_dvs_default)
+
+hal_client_domain(hal_dvs_default, hal_allocator)
+hal_client_domain(hal_dvs_default, hal_graphics_allocator)
+
+hal_attribute_hwservice(vendor_hal_dolby_dvs, hal_dvs_hwservice)
+
+binder_call(hal_dvs_default, system_server)
+
+allow hal_dvs_default fwk_sensor_hwservice:hwservice_manager find;
+allow hal_dvs_default sysfs_leds:dir search;
+allow hal_dvs_default sysfs_leds:file { getattr open read };
+
+set_prop(hal_dvs_default, vendor_dolby_vision_prop)
diff --git a/sepolicy/qti/vendor/hwservice.te b/sepolicy/qti/vendor/hwservice.te
index b7095f9..8edc47d 100644
--- a/sepolicy/qti/vendor/hwservice.te
+++ b/sepolicy/qti/vendor/hwservice.te
@@ -6,6 +6,9 @@
 # CommonDcs
 type vendor_hal_commondcs_hwservice, hwservice_manager_type, protected_hwservice;
 
+# Dolby Vision
+type hal_dvs_hwservice, hwservice_manager_type, protected_hwservice;
+
 # Face unlock
 type vendor_hal_face_hwservice, hwservice_manager_type, protected_hwservice;
 
diff --git a/sepolicy/qti/vendor/hwservice_contexts b/sepolicy/qti/vendor/hwservice_contexts
index 0299e69..8f8cb5d 100644
--- a/sepolicy/qti/vendor/hwservice_contexts
+++ b/sepolicy/qti/vendor/hwservice_contexts
@@ -18,6 +18,9 @@
 vendor.pixelworks.hardware.display::IIris           u:object_r:hal_graphics_composer_hwservice:s0
 vendor.pixelworks.hardware.feature::IIrisFeature    u:object_r:hal_graphics_composer_hwservice:s0
 
+# Dolby Vision
+vendor.dolby.dvs::IDvs    u:object_r:hal_dvs_hwservice:s0
+
 # Face unlock
 vendor.oplus.hardware.biometrics.face::IBiometricsFace    u:object_r:vendor_hal_face_hwservice:s0
 
diff --git a/sepolicy/qti/vendor/mediacodec.te b/sepolicy/qti/vendor/mediacodec.te
index 32f7db7..50be793 100644
--- a/sepolicy/qti/vendor/mediacodec.te
+++ b/sepolicy/qti/vendor/mediacodec.te
@@ -1 +1,3 @@
+hal_client_domain(mediacodec, vendor_hal_dolby_dvs)
+
 set_prop(mediacodec, vendor_video_prop)
