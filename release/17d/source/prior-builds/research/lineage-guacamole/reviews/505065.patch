diff --git a/sepolicy/qti/vendor/hal_graphics_composer_default.te b/sepolicy/qti/vendor/hal_graphics_composer_default.te
index 9eaf4bb..9323d3d 100644
--- a/sepolicy/qti/vendor/hal_graphics_composer_default.te
+++ b/sepolicy/qti/vendor/hal_graphics_composer_default.te
@@ -2,6 +2,7 @@
 
 add_service(hal_graphics_composer_default, hal_display_iris_aidl_service)
 add_service(hal_graphics_composer_default, hal_oplus_cwb_aidl_service)
+add_service(hal_graphics_composer_default, hal_oplus_display_mixlut3d_service)
 add_service(hal_graphics_composer_default, hal_oplus_displaycolor_aidl_service)
 
 allow hal_graphics_composer_default fwk_sensor_service:service_manager find;
diff --git a/sepolicy/qti/vendor/service.te b/sepolicy/qti/vendor/service.te
index ab5ef40..7b70d3b 100644
--- a/sepolicy/qti/vendor/service.te
+++ b/sepolicy/qti/vendor/service.te
@@ -15,6 +15,7 @@
 type hal_oplus_cwb_aidl_service, hal_service_type, service_manager_type;
 
 # Display
+type hal_oplus_display_mixlut3d_service, hal_service_type, service_manager_type;
 type hal_oplus_displaycolor_aidl_service, hal_service_type, service_manager_type;
 type hal_oplus_displaypanel_aidl_service, hal_service_type, service_manager_type;
 
diff --git a/sepolicy/qti/vendor/service_contexts b/sepolicy/qti/vendor/service_contexts
index 0db3741..9d80147 100644
--- a/sepolicy/qti/vendor/service_contexts
+++ b/sepolicy/qti/vendor/service_contexts
@@ -18,6 +18,7 @@
 vendor.oplus.hardware.cwb.ICwbService/default    u:object_r:hal_oplus_cwb_aidl_service:s0
 
 # Display
+vendor.oplus.hardware.display.MixLut3D.IMixLut3D/default                 u:object_r:hal_oplus_display_mixlut3d_service:s0
 vendor.oplus.hardware.displaycolorfeature.IDisplayColorFeature/default   u:object_r:hal_oplus_displaycolor_aidl_service:s0
 vendor.oplus.hardware.displaypanelfeature.IDisplayPanelFeature/default   u:object_r:hal_oplus_displaypanel_aidl_service:s0
 
