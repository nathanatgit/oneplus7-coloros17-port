From cd23d773818795dd80e5d1cc95cc06aa2ad80ea5 Mon Sep 17 00:00:00 2001
From: Saalim Quadri <danascape@gmail.com>
Date: Wed, 16 Sep 2026 23:56:50 +0530
Subject: [PATCH] SUW: Revamp ThemeSettings to ToggleGroups

Based on the design provided by Asher Simonds.

Co-authored-by: Asher S <dayanhammer@gmail.com>
Change-Id: I957fb9c6d87b0a0a998a11f90a41a9f666295965
Signed-off-by: Saalim Quadri <danascape@gmail.com>
---

diff --git a/app/src/main/java/org/lineageos/setupwizard/settings/ThemeSettingsActivity.kt b/app/src/main/java/org/lineageos/setupwizard/settings/ThemeSettingsActivity.kt
index 8ad24db..fc007e2 100644
--- a/app/src/main/java/org/lineageos/setupwizard/settings/ThemeSettingsActivity.kt
+++ b/app/src/main/java/org/lineageos/setupwizard/settings/ThemeSettingsActivity.kt
@@ -8,29 +8,34 @@
 import android.app.UiModeManager
 import android.content.res.Configuration
 import android.os.Bundle
-import android.widget.RadioGroup
+import com.google.android.material.button.MaterialButtonToggleGroup
 import org.lineageos.setupwizard.R
 import org.lineageos.setupwizard.base.BaseSetupWizardActivity
+import org.lineageos.setupwizard.util.updateCheckedIcons
 
 class ThemeSettingsActivity : BaseSetupWizardActivity() {
 
+    private val uiModeManager by lazy { getSystemService(UiModeManager::class.java) }
+
     override fun onCreate(savedInstanceState: Bundle?) {
         super.onCreate(savedInstanceState)
 
         glifLayout.setDescriptionText(getString(R.string.theme_summary))
 
-        val uiModeManager = getSystemService(UiModeManager::class.java)
-        val radioGroup: RadioGroup = findViewById(R.id.theme_radio_group)
+        val modeGroup = findViewById<MaterialButtonToggleGroup>(R.id.theme_mode_group)
         val isNight =
             (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) ==
                 Configuration.UI_MODE_NIGHT_YES
 
-        radioGroup.check(if (isNight) R.id.radio_dark else R.id.radio_light)
-        radioGroup.setOnCheckedChangeListener { _, checkedId ->
-            when (checkedId) {
-                R.id.radio_dark -> uiModeManager.setNightModeActivated(true)
-                R.id.radio_light -> uiModeManager.setNightModeActivated(false)
+        modeGroup.check(if (isNight) R.id.mode_dark else R.id.mode_light)
+        modeGroup.updateCheckedIcons(R.drawable.ic_check)
+
+        modeGroup.addOnButtonCheckedListener { _, checkedId, checked ->
+            if (!checked) {
+                return@addOnButtonCheckedListener
             }
+            modeGroup.updateCheckedIcons(R.drawable.ic_check)
+            uiModeManager.setNightModeActivated(checkedId == R.id.mode_dark)
         }
     }
 
diff --git a/app/src/main/res/layout/setup_theme.xml b/app/src/main/res/layout/setup_theme.xml
index ced50b9..3b61343 100644
--- a/app/src/main/res/layout/setup_theme.xml
+++ b/app/src/main/res/layout/setup_theme.xml
@@ -5,46 +5,62 @@
 -->
 <com.google.android.setupdesign.GlifLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
     android:id="@+id/setup_wizard_layout"
     android:layout_width="match_parent"
     android:layout_height="match_parent">
 
     <LinearLayout
-        android:orientation="vertical"
+        style="@style/SudContentFrame"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
-        style="@style/SudContentFrame"
-        android:layout_marginTop="@dimen/base_margin_top">
+        android:layout_marginTop="@dimen/base_margin_top"
+        android:orientation="vertical">
 
-        <FrameLayout
+        <ScrollView
             android:id="@+id/page"
             android:layout_width="match_parent"
             android:layout_height="0dp"
-            android:layout_weight="1">
+            android:layout_weight="1"
+            android:fillViewport="true">
 
-            <ScrollView
+            <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
-                android:fillViewport="true">
+                android:orientation="vertical">
 
-                <RadioGroup
-                    android:id="@+id/theme_radio_group"
+                <Space
                     android:layout_width="match_parent"
-                    android:layout_height="wrap_content">
+                    android:layout_height="0dp"
+                    android:layout_weight="1" />
 
-                    <RadioButton
-                        android:id="@+id/radio_dark"
-                        android:text="@string/dark"
-                        style="@style/SudRadioButton" />
+                <com.google.android.material.button.MaterialButtonToggleGroup
+                    android:id="@+id/theme_mode_group"
+                    style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    app:checkedButton="@+id/mode_dark"
+                    app:selectionRequired="true"
+                    app:singleSelection="true">
 
-                    <RadioButton
-                        android:id="@+id/radio_light"
-                        android:text="@string/light"
-                        style="@style/SudRadioButton" />
+                    <com.google.android.material.button.MaterialButton
+                        android:id="@+id/mode_dark"
+                        style="@style/Widget.Material3Expressive.Button.TonalButton"
+                        android:layout_width="0dp"
+                        android:layout_height="@dimen/connected_button_height"
+                        android:layout_weight="1"
+                        android:text="@string/dark" />
 
-                </RadioGroup>
-            </ScrollView>
-        </FrameLayout>
+                    <com.google.android.material.button.MaterialButton
+                        android:id="@+id/mode_light"
+                        style="@style/Widget.Material3Expressive.Button.TonalButton"
+                        android:layout_width="0dp"
+                        android:layout_height="@dimen/connected_button_height"
+                        android:layout_weight="1"
+                        android:text="@string/light" />
 
+                </com.google.android.material.button.MaterialButtonToggleGroup>
+            </LinearLayout>
+        </ScrollView>
     </LinearLayout>
 </com.google.android.setupdesign.GlifLayout>
