diff --git a/libbluetooth_audio_session_aidl/AudioConfigurationV4.cpp b/libbluetooth_audio_session_aidl/AudioConfigurationV4.cpp
new file mode 100644
index 0000000..512f6fb
--- /dev/null
+++ b/libbluetooth_audio_session_aidl/AudioConfigurationV4.cpp
@@ -0,0 +1,42 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <aidl/android/hardware/bluetooth/audio/AudioConfiguration.h>
+#include <aidl/lineage/compat/bluetooth/audio/v4/AudioConfiguration.h>
+#include <android/binder_parcel.h>
+#include <log/log.h>
+#include <memory>
+
+namespace current = aidl::android::hardware::bluetooth::audio;
+namespace legacy = aidl::lineage::compat::bluetooth::audio::v4;
+
+// Avoid depending on the private session object's layout.
+extern const current::AudioConfiguration getCurrentAudioConfig(void* session) asm(
+        "_ZN4aidl7android8hardware9bluetooth5audio21BluetoothAudioSession14GetAudioConfigEv");
+
+extern const legacy::AudioConfiguration getLegacyAudioConfigV4(void* session) asm(
+        "_ZN4aidl7android8hardware9bluetooth5audio21BluetoothAudioSession14GetAudioConfV4Ev");
+
+const legacy::AudioConfiguration getLegacyAudioConfigV4(void* session) {
+    const auto config = getCurrentAudioConfig(session);
+    legacy::AudioConfiguration result;
+    // New union alternatives have no V4 representation. A zero-rate PCM
+    // configuration makes the legacy software audio path reject the format.
+    if (static_cast<int>(config.getTag()) >
+        static_cast<int>(legacy::AudioConfiguration::Tag::a2dp)) {
+        ALOGE("Bluetooth audio configuration has no V4 representation");
+        return result;
+    }
+    // Stable AIDL parcel encoding provides field conversion without sharing
+    // the incompatible std::variant layout across the native ABI boundary.
+    std::unique_ptr<AParcel, decltype(&AParcel_delete)> parcel(AParcel_create(), AParcel_delete);
+    if (!parcel || config.writeToParcel(parcel.get()) != STATUS_OK ||
+        AParcel_setDataPosition(parcel.get(), 0) != STATUS_OK ||
+        result.readFromParcel(parcel.get()) != STATUS_OK) {
+        ALOGE("Failed to convert Bluetooth audio configuration to V4");
+        return legacy::AudioConfiguration{};
+    }
+    return result;
+}
diff --git a/libbluetooth_audio_session_aidl/legacy/Android.bp b/libbluetooth_audio_session_aidl/legacy/Android.bp
index 13684d9..1c1f4c0 100644
--- a/libbluetooth_audio_session_aidl/legacy/Android.bp
+++ b/libbluetooth_audio_session_aidl/legacy/Android.bp
@@ -21,3 +21,22 @@
         },
     },
 }
+
+// Private V4 data types for native callers built against Android 15.
+aidl_interface {
+    name: "lineage.compat.bluetooth.audio.v4",
+    vendor_available: true,
+    unstable: true,
+    srcs: ["lineage/compat/bluetooth/audio/v4/*.aidl"],
+    backend: {
+        java: {
+            enabled: false
+        },
+        cpp: {
+            enabled: false
+        },
+        ndk: {
+            enabled: true
+        },
+    },
+}
