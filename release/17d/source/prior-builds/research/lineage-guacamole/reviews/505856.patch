From b6964d9063f9d839af9a48f049fb247484410289 Mon Sep 17 00:00:00 2001
From: Michael Bestas <mkbestas@lineageos.org>
Date: Sun, 19 May 2024 13:31:03 +0300
Subject: [PATCH] libar-pal: Allow overriding speaker protection calibration path

This lets devices use factory calibration from persist partition.

Change-Id: If1b72c77603dd60d52dca3f739547b50b2da31d2
---

diff --git a/Android.bp b/Android.bp
index 80eab0d..858f279 100644
--- a/Android.bp
+++ b/Android.bp
@@ -26,13 +26,15 @@
         "-DACD_SM_FILEPATH=\"/vendor/etc/models/acd/\"",
         "-DADSP_SLEEP_MONITOR",
         "-DCONFIG_GSL",
-        "-DPAL_SP_TEMP_PATH=\"/data/vendor/audio/audio.cal\"",
         "-Wall",
         "-Werror",
         "-Wno-macro-redefined",
         "-Wno-unused-parameter",
         "-Wno-unused-variable",
-    ],
+    ] + select(soong_config_variable("qtiaudio", "pal_spkr_protection_path"), {
+        any @ path: ["-DPAL_SP_TEMP_PATH=\"" + path + "\""],
+        default: ["-DPAL_SP_TEMP_PATH=\"/data/vendor/audio/audio.cal\""],
+    }),
 
     cppflags: [
         "-fexceptions",
