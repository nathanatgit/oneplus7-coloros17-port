diff --git a/app/src/main/java/org/lineageos/canvas/ui/composables/ToolbarTooltip.kt b/app/src/main/java/org/lineageos/canvas/ui/composables/ToolbarTooltip.kt
new file mode 100644
index 0000000..09e95b0
--- /dev/null
+++ b/app/src/main/java/org/lineageos/canvas/ui/composables/ToolbarTooltip.kt
@@ -0,0 +1,30 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.canvas.ui.composables
+
+import androidx.compose.material3.ExperimentalMaterial3Api
+import androidx.compose.material3.PlainTooltip
+import androidx.compose.material3.Text
+import androidx.compose.material3.TooltipAnchorPosition
+import androidx.compose.material3.TooltipBox
+import androidx.compose.material3.TooltipDefaults
+import androidx.compose.material3.rememberTooltipState
+import androidx.compose.runtime.Composable
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ToolbarTooltip(
+    text: String,
+    position: TooltipAnchorPosition = TooltipAnchorPosition.Above,
+    content: @Composable () -> Unit,
+) {
+    TooltipBox(
+        positionProvider = TooltipDefaults.rememberTooltipPositionProvider(position),
+        tooltip = { PlainTooltip { Text(text) } },
+        state = rememberTooltipState(),
+        content = content,
+    )
+}
