diff --git a/app/src/main/java/org/lineageos/setupwizard/util/ButtonGroupUtils.kt b/app/src/main/java/org/lineageos/setupwizard/util/ButtonGroupUtils.kt
new file mode 100644
index 0000000..9a40a53
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/util/ButtonGroupUtils.kt
@@ -0,0 +1,21 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.util
+
+import androidx.annotation.DrawableRes
+import com.google.android.material.button.MaterialButton
+import com.google.android.material.button.MaterialButtonToggleGroup
+
+fun MaterialButtonToggleGroup.updateCheckedIcons(@DrawableRes iconResId: Int) {
+    for (index in 0 until childCount) {
+        val button = getChildAt(index) as? MaterialButton ?: continue
+        if (button.id == checkedButtonId) {
+            button.setIconResource(iconResId)
+        } else {
+            button.icon = null
+        }
+    }
+}
