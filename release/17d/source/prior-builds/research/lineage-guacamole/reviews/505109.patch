diff --git a/qcwcn/wifi_hal/configure.ac b/qcwcn/wifi_hal/configure.ac
new file mode 100644
index 0000000..2541a15
--- /dev/null
+++ b/qcwcn/wifi_hal/configure.ac
@@ -0,0 +1,133 @@
+# configure.ac -- Autoconf script for wifi-hal
+
+# Requires autoconf tool later than 2.61
+AC_PREREQ(2.61)
+# Initialize the qcacld-tools package version 1.0.0
+AC_INIT([qcwcn],1.0.0)
+# Does not strictly follow GNU Coding standards
+AM_INIT_AUTOMAKE([foreign])
+# Disables auto rebuilding of configure, Makefile.ins
+AM_MAINTAINER_MODE
+# defines some macros variable to be included by source
+AC_CONFIG_HEADERS([config.h])
+AC_CONFIG_MACRO_DIR([m4])
+
+# Checks for programs.
+AC_PROG_CC
+AC_PROG_CXX
+AM_PROG_CC_C_O
+AC_PROG_LIBTOOL
+AC_PROG_AWK
+AC_PROG_CPP
+AC_PROG_INSTALL
+AC_PROG_LN_S
+AC_PROG_MAKE_SET
+
+# Checks for libraries.
+PKG_CHECK_MODULES([DIAG], [diag])
+AC_SUBST([DIAG_CFLAGS])
+AC_SUBST([DIAG_LIBS])
+
+AC_ARG_WITH([glib],
+      AC_HELP_STRING([--with-glib],
+         [enable glib, building FTM Daemon which use glib]))
+
+if (test "x${with_glib}" = "xyes"); then
+        PKG_CHECK_MODULES(GTHREAD, gthread-2.0 >= 2.16, dummy=yes,
+                               AC_MSG_ERROR(GThread >= 2.16 is required))
+        PKG_CHECK_MODULES(GLIB, glib-2.0 >= 2.16, dummy=yes,
+                                AC_MSG_ERROR(GLib >= 2.16 is required))
+        GLIB_CFLAGS="$GLIB_CFLAGS $GTHREAD_CFLAGS"
+        GLIB_LIBS="$GLIB_LIBS $GTHREAD_LIBS"
+
+        AC_SUBST(GLIB_CFLAGS)
+        AC_SUBST(GLIB_LIBS)
+fi
+AM_CONDITIONAL(USE_GLIB, test "x${with_glib}" = "xyes")
+
+AC_ARG_ENABLE([debug],
+        [  --enable-debug    Turn on debugging],
+        [case "${enableval}" in
+            yes) debug=true ;;
+            no)  debug=false ;;
+            *) AC_MSG_ERROR([bad value ${enableval} for --enable-debug]) ;;
+        esac],[debug=false])
+AM_CONDITIONAL([DEBUG], [test x$debug = xtrue])
+
+# Checks for typedefs, structures, and compiler characteristics.
+AC_HEADER_STDBOOL
+AC_HEADER_STDC
+AC_C_INLINE
+AC_TYPE_INT64_T
+AC_TYPE_PID_T
+AC_TYPE_SIZE_T
+AC_TYPE_SSIZE_T
+AC_TYPE_UINT16_T
+AC_TYPE_UINT32_T
+AC_TYPE_UINT8_T
+
+# Checks for library functions.
+AC_FUNC_ERROR_AT_LINE
+AC_FUNC_FORK
+AC_FUNC_MALLOC
+
+AC_ARG_WITH([system-core-includes],
+     AC_HELP_STRING([--with-system-core-includes=@<:@dir@:>@],
+        [Specify the location of the system core headers]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     with_system_core_includes=no)
+
+AC_ARG_WITH([libhardware-legacy-includes],
+     AC_HELP_STRING([--with-libhardware-legacy-includes=@<:@dir@:>@],
+        [Specify the location of the libhardware legacy headers]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     with_libhardware_legacy_includes=no)
+
+AC_ARG_WITH([supplicant-header-includes],
+     AC_HELP_STRING([--with-supplicant-header-includes=@<:@dir@:>@],
+        [Specify the location of the supplicant header includes]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     supplicant-header-includes=no)
+
+AC_ARG_WITH([supplicant-utils-includes],
+      AC_HELP_STRING([--with_supplicant-utils-includes=@<:@dir@:>@],
+         [Specify the location of the supplicant header includes]),
+      [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+      with_supplicant-utils-includes=no)
+
+AC_ARG_WITH([supplicant-includes],
+      AC_HELP_STRING([--with_supplicant-includes=@<:@dir@:>@],
+         [Specify the location of the supplicant header includes]),
+      [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+      with_supplicant-includes=no)
+
+AC_ARG_WITH([cld80211-lib-includes],
+     AC_HELP_STRING([--with-cld80211-lib-includes=@<:@dir@:>@],
+        [Specify the location of the cld80211 lib headers]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     cld80211-lib-includes=no)
+
+AC_ARG_WITH([libnl-includes],
+     AC_HELP_STRING([--with-libnl-includes=@<:@dir@:>@],
+        [Specify the location of the libnl lib headers]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     libnl-includes=no)
+
+AC_ARG_WITH([vendor-nan-includes],
+     AC_HELP_STRING([--with-vendor-nan-includes=@<:@dir@:>@],
+        [Specify the location of the vendor nan headers]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     vendor-nan-includes=no)
+
+AC_ARG_WITH([wifi-hal-ctrl-includes],
+     AC_HELP_STRING([--with-wifi-hal-ctrl-includes=@<:@dir@:>@],
+        [Specify the location of the wifi hal ctrl headers]),
+     [CPPFLAGS="$CPPFLAGS -idirafter $withval"],
+     wifi-hal-ctrl-includes=no)
+
+AC_SUBST([CPPFLAGS])
+
+AC_CONFIG_FILES([ \
+	Makefile \
+])
+AC_OUTPUT
