     }
     auto removeStreams = [&](std::weak_ptr<StreamOut> streamOut) -> bool {
-        if (!streamOut.lock()) return true;
-        return streamOut.lock()->isClosed();
+         if (auto sharedStream = streamOut.lock()) {
