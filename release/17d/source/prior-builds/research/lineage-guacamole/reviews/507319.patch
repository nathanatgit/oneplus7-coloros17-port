From 56fd9f0ed9a36a80a518d1e22ea17196719bd39d Mon Sep 17 00:00:00 2001
From: Bruno Martins <bgcngm@gmail.com>
Date: Sat, 10 Oct 2026 14:50:09 +0100
Subject: [PATCH] compat: Adapt Bluetooth audio configurations for V3 callers

Legacy audio HALs allocate a V3 AudioConfiguration return object,
while the current session library returns the larger V6 type.
This corrupts the stack when opening A2DP.

Add a dedicated GetAudioConfV3 entry point that converts through
AIDL parcels into private V3 types, preserving the native layout
expected by legacy callers.

Assisted-by: LLM
Change-Id: Ia0019417a56d53f3ac311cfc83744044ae476a5c
---

diff --git a/Android.bp b/Android.bp
index 1af7c43..19009a8 100644
--- a/Android.bp
+++ b/Android.bp
@@ -76,11 +76,18 @@
     name: "libbluetooth_audio_session_aidl_shim",
     shared_libs: [
         "libbluetooth_audio_session_aidl",
+        "libbinder_ndk",
+        "liblog",
     ],
     srcs: [
+        "libbluetooth_audio_session_aidl/AudioConfigurationV3.cpp",
         "libbluetooth_audio_session_aidl/BluetoothAudioSession.cpp",
     ],
     vendor: true,
+    defaults: ["latest_android_hardware_bluetooth_audio_ndk_shared"],
+    static_libs: [
+        "lineage.compat.bluetooth.audio.v3-ndk",
+    ],
 }
 
 cc_defaults {
diff --git a/libbluetooth_audio_session_aidl/AudioConfigurationV3.cpp b/libbluetooth_audio_session_aidl/AudioConfigurationV3.cpp
new file mode 100644
index 0000000..f73d689
--- /dev/null
+++ b/libbluetooth_audio_session_aidl/AudioConfigurationV3.cpp
@@ -0,0 +1,42 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <aidl/android/hardware/bluetooth/audio/AudioConfiguration.h>
+#include <aidl/lineage/compat/bluetooth/audio/v3/AudioConfiguration.h>
+#include <android/binder_parcel.h>
+#include <log/log.h>
+#include <memory>
+
+namespace current = aidl::android::hardware::bluetooth::audio;
+namespace legacy = aidl::lineage::compat::bluetooth::audio::v3;
+
+// Avoid depending on the private session object's layout.
+extern const current::AudioConfiguration getCurrentAudioConfig(void* session) asm(
+        "_ZN4aidl7android8hardware9bluetooth5audio21BluetoothAudioSession14GetAudioConfigEv");
+
+extern const legacy::AudioConfiguration getLegacyAudioConfig(void* session) asm(
+        "_ZN4aidl7android8hardware9bluetooth5audio21BluetoothAudioSession14GetAudioConfV3Ev");
+
+const legacy::AudioConfiguration getLegacyAudioConfig(void* session) {
+    const auto config = getCurrentAudioConfig(session);
+    legacy::AudioConfiguration result;
+    // New union alternatives have no V3 representation. A zero-rate PCM
+    // configuration makes the legacy software audio path reject the format.
+    if (static_cast<int>(config.getTag()) >
+        static_cast<int>(legacy::AudioConfiguration::Tag::leAudioBroadcastConfig)) {
+        ALOGE("Bluetooth audio configuration has no V3 representation");
+        return result;
+    }
+    // Stable AIDL parcel encoding provides field conversion without sharing
+    // the incompatible std::variant layout across the native ABI boundary.
+    std::unique_ptr<AParcel, decltype(&AParcel_delete)> parcel(AParcel_create(), AParcel_delete);
+    if (!parcel || config.writeToParcel(parcel.get()) != STATUS_OK ||
+        AParcel_setDataPosition(parcel.get(), 0) != STATUS_OK ||
+        result.readFromParcel(parcel.get()) != STATUS_OK) {
+        ALOGE("Failed to convert Bluetooth audio configuration to V3");
+        return legacy::AudioConfiguration{};
+    }
+    return result;
+}
diff --git a/libbluetooth_audio_session_aidl/legacy/Android.bp b/libbluetooth_audio_session_aidl/legacy/Android.bp
new file mode 100644
index 0000000..13684d9
--- /dev/null
+++ b/libbluetooth_audio_session_aidl/legacy/Android.bp
@@ -0,0 +1,23 @@
+//
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+//
+
+// Private, namespaced copies of the V3 data types for legacy native callers.
+aidl_interface {
+    name: "lineage.compat.bluetooth.audio.v3",
+    vendor_available: true,
+    unstable: true,
+    srcs: ["lineage/compat/bluetooth/audio/v3/*.aidl"],
+    backend: {
+        java: {
+            enabled: false
+        },
+        cpp: {
+            enabled: false
+        },
+        ndk: {
+            enabled: true
+        },
+    },
+}
