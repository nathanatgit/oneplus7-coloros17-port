From 554ba69fc5aed8bac353a2d226fa2871918552b1 Mon Sep 17 00:00:00 2001
From: Timi <timi.rautamaki@gmail.com>
Date: Tue, 13 Oct 2026 17:04:12 +0300
Subject: [PATCH] Catapult: Sort all apps alphabetically

Change-Id: I9d57fe13e411be8505578e2030e62c81c1c217ea
---

diff --git a/app/src/main/java/org/lineageos/tv/launcher/flow/InstalledAppsFlow.kt b/app/src/main/java/org/lineageos/tv/launcher/flow/InstalledAppsFlow.kt
index 14b709b..8a4d362 100644
--- a/app/src/main/java/org/lineageos/tv/launcher/flow/InstalledAppsFlow.kt
+++ b/app/src/main/java/org/lineageos/tv/launcher/flow/InstalledAppsFlow.kt
@@ -8,6 +8,7 @@
 import android.content.Context
 import android.content.Intent
 import android.content.IntentFilter
+import android.icu.text.Collator
 import kotlinx.coroutines.flow.mapNotNull
 import org.lineageos.tv.launcher.ext.broadcastFlow
 import org.lineageos.tv.launcher.model.AppInfo
@@ -15,6 +16,9 @@
 
 class InstalledAppsFlow(private val context: Context) {
     private val packageManager = context.packageManager
+    private val collator = Collator.getInstance().apply {
+        strength = Collator.PRIMARY
+    }
     private val leanbackLauncherIntent = Intent(Intent.ACTION_MAIN).apply {
         addCategory(Intent.CATEGORY_LEANBACK_LAUNCHER)
     }
@@ -56,7 +60,7 @@
                 packageManager,
                 0
             )?.name
-        }
+        }.sortedWith(compareBy(collator) { it.label })
     }
 
     companion object {
