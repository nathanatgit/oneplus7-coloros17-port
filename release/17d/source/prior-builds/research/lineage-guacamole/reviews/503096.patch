     android:entries="@xml/accessibility_service_suw_screen_items"
     android:icon="@drawable/ic_accessibility_visibility"
+    app:sudUpscaleIcon="true"
     app:sudAnimationIcon="@raw/icon_visibility"/>
\ No newline at end of file
