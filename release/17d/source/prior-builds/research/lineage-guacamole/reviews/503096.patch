diff --git a/res/layout/accessibility_service_suw_screen.xml b/res/layout/accessibility_service_suw_screen.xml
index 2f15a4a..e875615 100644
--- a/res/layout/accessibility_service_suw_screen.xml
+++ b/res/layout/accessibility_service_suw_screen.xml
@@ -23,4 +23,5 @@
