+        <item name="sudMarginStart">@dimen/tv_overscan_horizontal</item>
+        <item name="sudMarginEnd">@dimen/tv_overscan_horizontal</item>
+        <item name="sucGlifIconMarginTop">@dimen/tv_overscan_vertical</item>
+        <item name="sucFooterBarPaddingStart">@dimen/tv_overscan_horizontal</item>
+        <item name="sucFooterBarPaddingEnd">@dimen/tv_overscan_horizontal</item>
+        <item name="sucFooterBarPaddingTop">@dimen/tv_overscan_vertical</item>
+        <item name="sucFooterBarPaddingBottom">@dimen/tv_overscan_vertical</item>
+    </style>
+</resources>
