 public final class SplitKeyboardUtils {
     public static final float SPLIT_KEYBOARD_HEIGHT_RATIO = 0.78f;
+    private static final int PHONE_SMALLEST_SCREEN_WIDTH_DP = 360;
 
     private SplitKeyboardUtils() {
     }
