From b02a534af4f4d8f100f446587abd33e019ddba68 Mon Sep 17 00:00:00 2001
From: Bruno Martins <bgcngm@gmail.com>
Date: Sun, 27 Sep 2026 14:53:59 +0100
Subject: [PATCH] sepolicy: qti: Add face unlock support

Co-authored-by: LuK1337 <priv.luk@gmail.com>
Change-Id: I681c4caf1f5673ee2433dcc20205b1523d6a2b5d
---

diff --git a/sepolicy/qti/public/attributes b/sepolicy/qti/public/attributes
index 9e2269f..4d304bb 100644
--- a/sepolicy/qti/public/attributes
+++ b/sepolicy/qti/public/attributes
@@ -7,6 +7,7 @@
 vendor_hal_attribute(oplus_displaypanelfeature)
 vendor_hal_attribute(oplus_eid)
 vendor_hal_attribute(oplus_esim)
+vendor_hal_attribute(oplus_face)
 vendor_hal_attribute(oplus_osense)
 vendor_hal_attribute(oplus_performance)
 vendor_hal_attribute(oplus_project)
diff --git a/sepolicy/qti/vendor/common-um/hal_oplus_face.te b/sepolicy/qti/vendor/common-um/hal_oplus_face.te
new file mode 100644
index 0000000..47f9892
--- /dev/null
+++ b/sepolicy/qti/vendor/common-um/hal_oplus_face.te
@@ -0,0 +1,2 @@
+allow hal_oplus_face vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
+allow hal_oplus_face vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
diff --git a/sepolicy/qti/vendor/file.te b/sepolicy/qti/vendor/file.te
index 60d9b0d..3e5deae 100644
--- a/sepolicy/qti/vendor/file.te
+++ b/sepolicy/qti/vendor/file.te
@@ -19,6 +19,9 @@
 # Engineering
 type vendor_proc_engineer, fs_type, proc_type;
 
+# Face unlock
+type face_picture_file, file_type, data_file_type;
+
 # Fingerprint
 type vendor_persist_fingerprint_file, file_type;
 type vendor_proc_fingerprint, fs_type, proc_type;
diff --git a/sepolicy/qti/vendor/file_contexts b/sepolicy/qti/vendor/file_contexts
index d6d4b81..6c8b14e 100644
--- a/sepolicy/qti/vendor/file_contexts
+++ b/sepolicy/qti/vendor/file_contexts
@@ -50,6 +50,10 @@
 /dev/esim-en                                                           u:object_r:esim_en_device:s0
 /dev/esim-gpio                                                         u:object_r:esim_gpio_device:s0
 
+# Face unlock
+/data/vendor_de/[0-9]+/faceunlock(_ori)?(/.*)?                                            u:object_r:face_picture_file:s0
+/(odm|vendor/odm)/bin/hw/vendor\.oplus\.hardware\.biometrics\.face@1\.0-service(_uff)?    u:object_r:hal_oplus_face_exec:s0
+
 # Fingerprint
 /data/vendor/fingerprint(_ori)?(/.*)?                                                            u:object_r:fingerprint_vendor_data_file:s0
 /mnt/vendor/persist/fingerprint(/.*)?                                                            u:object_r:vendor_persist_fingerprint_file:s0
diff --git a/sepolicy/qti/vendor/hal_oplus_face.te b/sepolicy/qti/vendor/hal_oplus_face.te
new file mode 100644
index 0000000..c7c8c70
--- /dev/null
+++ b/sepolicy/qti/vendor/hal_oplus_face.te
@@ -0,0 +1,37 @@
+type hal_oplus_face, domain;
+binder_use(hal_oplus_face)
+
+type hal_oplus_face_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(hal_oplus_face)
+
+binder_call(vendor_hal_oplus_face_client, vendor_hal_oplus_face_server)
+
+hal_client_domain(hal_oplus_face, hal_graphics_allocator)
+hal_client_domain(hal_oplus_face, vendor_hal_oplus_commondcs)
+hal_server_domain(hal_oplus_face, hal_face)
+hal_server_domain(hal_oplus_face, vendor_hal_oplus_face)
+
+allow hal_oplus_face fwk_camera_service:service_manager find;
+allow hal_oplus_face fwk_sensor_service:service_manager find;
+allow hal_oplus_face fwk_stats_service:service_manager find;
+allow hal_oplus_face hal_graphics_allocator_service:service_manager find;
+allow hal_oplus_face hal_oplus_commondcs_aidl_service:service_manager find;
+allow hal_oplus_face hal_oplus_olc_aidl_service:service_manager find;
+allow hal_oplus_face osense_service:service_manager find;
+
+allow hal_oplus_face fwk_camera_hwservice:hwservice_manager find;
+allow hal_oplus_face hal_graphics_allocator_hwservice:hwservice_manager find;
+allow hal_oplus_face hal_graphics_mapper_hwservice:hwservice_manager find;
+allow hal_oplus_face hidl_token_hwservice:hwservice_manager find;
+allow hal_oplus_face vendor_hal_orms_hwservice:hwservice_manager find;
+allow hal_oplus_face vendor_hal_osense_hwservice:hwservice_manager find;
+
+allow hal_oplus_face gpu_device:chr_file rw_file_perms;
+allow hal_oplus_face tee_device:chr_file rw_file_perms;
+
+allow hal_oplus_face face_picture_file:dir create_dir_perms;
+allow hal_oplus_face face_picture_file:file create_file_perms;
+
+get_prop(hal_oplus_face, camera_config_prop)
+get_prop(hal_oplus_face, system_oplus_project_prop)
+set_prop(hal_oplus_face, vendor_face_prop)
diff --git a/sepolicy/qti/vendor/hal_oplus_sensor_aidl.te b/sepolicy/qti/vendor/hal_oplus_sensor_aidl.te
index 4372a58..4809fdc 100644
--- a/sepolicy/qti/vendor/hal_oplus_sensor_aidl.te
+++ b/sepolicy/qti/vendor/hal_oplus_sensor_aidl.te
@@ -15,6 +15,10 @@
 
 allow hal_oplus_sensor_aidl mnt_vendor_file:dir search;
 
+allow hal_oplus_sensor_aidl vendor_persist_camera_file:dir rw_dir_perms;
+allow hal_oplus_sensor_aidl vendor_persist_camera_file:file create_file_perms;
+allow hal_oplus_sensor_aidl vendor_persist_camera_file:lnk_file r_file_perms;
+
 r_dir_file(hal_oplus_sensor_aidl, vendor_persist_engineer_file)
 r_dir_file(hal_oplus_sensor_aidl, vendor_persist_sensors_file)
 rw_dir_file(hal_oplus_sensor_aidl, vendor_proc_eng_cali_file)
diff --git a/sepolicy/qti/vendor/hwservice.te b/sepolicy/qti/vendor/hwservice.te
index cdaad17..b7095f9 100644
--- a/sepolicy/qti/vendor/hwservice.te
+++ b/sepolicy/qti/vendor/hwservice.te
@@ -6,6 +6,9 @@
 # CommonDcs
 type vendor_hal_commondcs_hwservice, hwservice_manager_type, protected_hwservice;
 
+# Face unlock
+type vendor_hal_face_hwservice, hwservice_manager_type, protected_hwservice;
+
 # ORMS
 type vendor_hal_orms_hwservice, hwservice_manager_type, protected_hwservice;
 
diff --git a/sepolicy/qti/vendor/hwservice_contexts b/sepolicy/qti/vendor/hwservice_contexts
index b734543..0299e69 100644
--- a/sepolicy/qti/vendor/hwservice_contexts
+++ b/sepolicy/qti/vendor/hwservice_contexts
@@ -18,6 +18,9 @@
 vendor.pixelworks.hardware.display::IIris           u:object_r:hal_graphics_composer_hwservice:s0
 vendor.pixelworks.hardware.feature::IIrisFeature    u:object_r:hal_graphics_composer_hwservice:s0
 
+# Face unlock
+vendor.oplus.hardware.biometrics.face::IBiometricsFace    u:object_r:vendor_hal_face_hwservice:s0
+
 # Fingerprint
 vendor.oplus.hardware.biometrics.fingerprint::IBiometricsFingerprint    u:object_r:hal_fingerprint_hwservice:s0
 
diff --git a/sepolicy/qti/vendor/property.te b/sepolicy/qti/vendor/property.te
index 6b6ac05..aa929fa 100644
--- a/sepolicy/qti/vendor/property.te
+++ b/sepolicy/qti/vendor/property.te
@@ -1,6 +1,9 @@
 # eSIM
 vendor_internal_prop(vendor_oplus_esim_prop)
 
+# Face unlock
+vendor_internal_prop(vendor_face_prop)
+
 # Fingerprint
 vendor_internal_prop(vendor_fingerprint_prop)
 
diff --git a/sepolicy/qti/vendor/property_contexts b/sepolicy/qti/vendor/property_contexts
index 022507f..4185cb0 100644
--- a/sepolicy/qti/vendor/property_contexts
+++ b/sepolicy/qti/vendor/property_contexts
@@ -15,6 +15,11 @@
 # eSIM
 ro.vendor.oplus.esim.support    u:object_r:vendor_oplus_esim_prop:s0
 
+# Face unlock
+persist.vendor.face.          u:object_r:vendor_face_prop:s0
+persist.vendor.oplus.face.    u:object_r:vendor_face_prop:s0
+vendor.oplus.face.            u:object_r:vendor_face_prop:s0
+
 # Fingerprint
 persist.vendor.fingerprint.                    u:object_r:vendor_fingerprint_prop:s0
 persist.vendor.side.fp.near.feature.support    u:object_r:vendor_fingerprint_prop:s0
diff --git a/sepolicy/qti/vendor/tee.te b/sepolicy/qti/vendor/tee.te
index d01bbea..51da408 100644
--- a/sepolicy/qti/vendor/tee.te
+++ b/sepolicy/qti/vendor/tee.te
@@ -3,6 +3,9 @@
 allow tee vendor_persist_fingerprint_file:dir create_dir_perms;
 allow tee vendor_persist_fingerprint_file:file create_file_perms;
 
+allow tee face_vendor_data_file:dir create_dir_perms;
+allow tee face_vendor_data_file:file create_file_perms;
+
 allow tee fingerprint_vendor_data_file:dir create_dir_perms;
 allow tee fingerprint_vendor_data_file:file create_file_perms;
 
