From f3b5777eccd22ade97614b689d10cf9d4fc3f650 Mon Sep 17 00:00:00 2001
From: Saalim Quadri <danascape@gmail.com>
Date: Wed, 16 Sep 2026 14:32:49 +0530
Subject: [PATCH] SUW: Use setup design footer bar for network setup

Change-Id: I2dac04e7658bd4bbc7bb75cb32715494472b54a4
Signed-off-by: Saalim Quadri <danascape@gmail.com>
---

diff --git a/app/src/main/java/org/lineageos/setupwizard/network/NetworkSetupActivity.kt b/app/src/main/java/org/lineageos/setupwizard/network/NetworkSetupActivity.kt
index 40f07a1..85ee558 100644
--- a/app/src/main/java/org/lineageos/setupwizard/network/NetworkSetupActivity.kt
+++ b/app/src/main/java/org/lineageos/setupwizard/network/NetworkSetupActivity.kt
@@ -7,6 +7,7 @@
 package org.lineageos.setupwizard.network
 
 import android.content.Intent
+import com.google.android.setupcompat.partnerconfig.PartnerConfigHelper
 import com.google.android.setupcompat.util.ResultCodes.RESULT_SKIP
 import org.lineageos.setupwizard.EXTRA_ENABLE_NEXT_ON_CONNECT
 import org.lineageos.setupwizard.EXTRA_PREFS_SET_BACK_TEXT
@@ -33,8 +34,10 @@
 
         val intent =
             Intent(ACTION_SETUP_NETWORK).apply {
-                putExtra(EXTRA_PREFS_SHOW_BUTTON_BAR, true)
-                putExtra(EXTRA_PREFS_SHOW_SKIP, true)
+                if (!PartnerConfigHelper.isGlifExpressiveEnabled(this@NetworkSetupActivity)) {
+                    putExtra(EXTRA_PREFS_SHOW_BUTTON_BAR, true)
+                    putExtra(EXTRA_PREFS_SHOW_SKIP, true)
+                }
                 putExtra(EXTRA_PREFS_SHOW_SKIP_TV, true)
                 putExtra(EXTRA_PREFS_SET_BACK_TEXT, null as String?)
                 putExtra(EXTRA_ENABLE_NEXT_ON_CONNECT, true)
