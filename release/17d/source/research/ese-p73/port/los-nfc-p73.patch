 obj-$(CONFIG_NFC_NQ)		+= nq-nci.o
 obj-$(CONFIG_NTAG_NQ)		+= nq-ntag.o
+obj-$(CONFIG_NFC_P73_ESE)	+= ese/
diff --git a/drivers/nfc/nq-nci.c b/drivers/nfc/nq-nci.c
index c366aef2e..ca000bea1 100644
--- a/drivers/nfc/nq-nci.c
+++ b/drivers/nfc/nq-nci.c
@@ -497,6 +497,17 @@ static int nqx_ese_pwr(struct nqx_dev *nqx_dev, unsigned long int arg)
 	return r;
 }
 
+static struct nqx_dev *g_nqx_dev;
+
+/* Used by drivers/nfc/ese/p73.c: arg 0 = eSE on, 1 = off, 3 = read state */
+int nqx_ese_pwr_ext(unsigned long arg)
+{
+	if (!g_nqx_dev)
+		return -ENODEV;
+	return nqx_ese_pwr(g_nqx_dev, arg);
+}
+EXPORT_SYMBOL(nqx_ese_pwr_ext);
+
 static int nfc_open(struct inode *inode, struct file *filp)
 {
 	struct nqx_dev *nqx_dev = container_of(inode->i_cdev,
@@ -1190,6 +1201,17 @@ static int nfc_parse_dt(struct device *dev, struct nqx_platform_data *pdata)
 	}
 
 	pdata->ese_gpio = of_get_named_gpio(np, "qcom,nq-esepwr", 0);
+	/*
+	 * OnePlus board wires the eSE power request to TLMM 49 (stock overlay:
+	 * nxp,pn544-ese-pwr = <&tlmm 49>), not to the Qualcomm reference pin
+	 * (TLMM 42, i.e. VEN + 1) that the LineageOS overlay still carries.
+	 */
+	if (gpio_is_valid(pdata->ese_gpio) && gpio_is_valid(pdata->en_gpio) &&
+	    pdata->ese_gpio == pdata->en_gpio + 1) {
+		pr_info("nq-nci: OnePlus board wires the eSE power to TLMM49, not %d\n",
+			pdata->ese_gpio);
+		pdata->ese_gpio = pdata->en_gpio + (49 - 41);
+	}
 	if (!gpio_is_valid(pdata->ese_gpio)) {
 		dev_warn(dev,
 			"ese GPIO <OPTIONAL> error getting from OF node\n");
@@ -1485,6 +1507,7 @@ static int nqx_probe(struct i2c_client *client,
 	device_init_wakeup(&client->dev, true);
 	device_set_wakeup_capable(&client->dev, true);
 	i2c_set_clientdata(client, nqx_dev);
+	g_nqx_dev = nqx_dev;
 	nqx_dev->irq_wake_up = false;
 
