diff --git a/drivers/nfc/Kconfig b/drivers/nfc/Kconfig
index 224da2fe2..8863421a2 100644
--- a/drivers/nfc/Kconfig
+++ b/drivers/nfc/Kconfig
@@ -77,3 +77,10 @@ config NTAG_NQ
           This is for i2c connected version.
 
 source "drivers/nfc/max32560/Kconfig"
+
+config NFC_P73_ESE
+	tristate "NXP P61/P73 eSE SPI node (/dev/p73) on top of NFC_NQ"
+	depends on SPI && NFC_NQ
+	help
+	  Exposes the NXP eSE on SPI (compatible nxp,p61) as /dev/p73 and
+	  powers it through the nq-nci NFC driver.
