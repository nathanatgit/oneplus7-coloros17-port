# ColorOS screen color mode -> LiveDisplay bridge (tools/live/colormode): script run by init service port_colormode at boot_completed
port/bin/port-colormode.sh  bin/port-colormode.sh  0755 vendor_file
port/etc/init/port-colormode.rc  etc/init/port-colormode.rc  0644 vendor_configs_file
# ColorOS charging limit (regular charge protection) -> battery/mmi_charging_enable (tools/live/chglimit): script run by init service port_chglimit at boot_completed
port/bin/port-chglimit.sh  bin/port-chglimit.sh  0755 vendor_file
port/etc/init/port-chglimit.rc  etc/init/port-chglimit.rc  0644 vendor_configs_file
# (B8, live-verified 2026-10-30) no-op AIDL vendor.qti.hardware.perf2.IPerf/default (tools/live/perf-stub/PerfStub.java): stops ColorOS's
# Qualcomm perf client falling back to HIDL perf@2.3/@2.2 lazy starts (~4/s from system_server). Boosting stays with the LOS power HAL.
port/etc/vintf/manifest/manifest_port_perf2.xml  etc/vintf/manifest/manifest_port_perf2.xml  0644 vendor_configs_file
port/etc/init/port-perf2-stub.rc  etc/init/port-perf2-stub.rc  0644 vendor_configs_file
port/lib64/port-stubs.dex  lib64/port-stubs.dex  0644 vendor_file
# B21: bind real fuel-gauge (bms/capacity) over battery/capacity for health HAL (tools/live/battery-gauge)
port/bin/port-bmslevel.sh  bin/port-bmslevel.sh  0755 vendor_file
port/etc/init/port-bmslevel.rc  etc/init/port-bmslevel.rc  0644 vendor_configs_file
# B22 (17k-r2): defensive guard, clears Settings.Global restricted_networking_mode if it is 1 (tools/live/netguard); oneshot, 4 checks over ~5 min at boot
port/bin/port-netguard.sh  bin/port-netguard.sh  0755 vendor_file
port/etc/init/port-netguard.rc  etc/init/port-netguard.rc  0644 vendor_configs_file
# B24/B25b (17k-r2): slider DOWN = hold, release ends the 一键闪记 capture (tools/live/slider-hold). dex bind-mounted over system's oplus-port-stubs.dex at "on boot" by port_sliderdex; stock dex stays if anything is wrong
port/bin/port-slider-hold.dex  bin/port-slider-hold.dex  0644 vendor_file
port/bin/port-sliderdex.sh  bin/port-sliderdex.sh  0755 vendor_file
port/etc/init/port-sliderdex.rc  etc/init/port-sliderdex.rc  0644 vendor_configs_file
# B27 (17k-r3): dummy IOfflineCameraService/default (same port.OplusStubs class, started at "on boot", restarted by init) so cameraserver's APS timer does not abort; see tools/live/offlinecam-stub
port/etc/init/port-offlinecam-stub.rc  etc/init/port-offlinecam-stub.rc  0644 vendor_configs_file
