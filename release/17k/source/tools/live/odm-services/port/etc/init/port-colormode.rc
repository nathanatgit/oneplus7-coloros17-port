# OnePlus7Port: forward ColorOS's screen color mode to the panel's LiveDisplay modes (tools/live/colormode/port-colormode.sh).
service port_colormode /system/bin/sh /odm/bin/port-colormode.sh
    class late_start
    user system
    group system
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start port_colormode
